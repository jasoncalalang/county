# Copy to .env.local for `npm run dev`. Never commit real values.
# Auth.js (ADR 0002, ADR 0010). Google redirect URI: <AUTH_URL>/callback/google
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000/auth
AUTH_GOOGLE_ID=your-google-oauth-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
# Where the web server reaches the API (the reseller page). In the cluster: http://county-api:8080/api
COUNTY_API_URL=http://localhost:8080/api
# Development only: proxy the browser's /api calls to this origin, since there is no Ingress locally.
COUNTY_DEV_API_ORIGIN=http://localhost:8080
